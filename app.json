{
  "expo": {
    "name": "Random Topic Generator",
    "slug": "random-topic-generator",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.rork.random-topic-generator"
    },
    "android": {
      "package": "app.rork.random_topic_generator"
    },
    "web": {
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
